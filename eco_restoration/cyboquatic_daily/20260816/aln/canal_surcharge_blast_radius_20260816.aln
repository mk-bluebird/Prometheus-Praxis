TITLE CanalSurchargeBlastRadius20260816
VERSION 1.0.0
CATEGORY ECO_RESTORATION
SUMMARY Conservative canal surcharge exposure zoning for low-impact machinery dispatch.

meta
  ownerrepo string "mk-bluebird/Prometheus-Praxis"
  issuedutc string "2026-08-16T00:00:00Z"
  maintainerdid string "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  artifactid string "PHX-CANAL-BR-20260816"
endmeta

enum Zone
  SAFE
  CAUTION
  EXCLUDE
endenum

enum FogMediaState
  MODELED_WATER
  UNMODELED_MIXED_MEDIA
  UNKNOWN_MEDIA
endenum

particle CanalSurchargeBlastRadius
  canalnodeid string required
  fogmediastate FogMediaState required
  breachflowlps decimal required range 0.001 100000.0
  surchargedurations decimal required range 0.001 604800.0
  banksensitivity decimal required range 0.0 1.0
  evaluateddistancem decimal required range 0.0 100000.0
  energyreqJ decimal required range 0.0 1000000000.0
  deltaVt decimal required range 0.0 10000.0
  knowledgefactor decimal required range 0.0 1.0
  ecoimpactvalue decimal required range 0.0 1.0
  harmrisk decimal required range 0.0 1.0
  zone Zone required

  invariant harmrisk >= 0.0
  invariant harmrisk <= 1.0
  invariant knowledgefactor >= 0.0
  invariant knowledgefactor <= 1.0
  invariant ecoimpactvalue >= 0.0
  invariant ecoimpactvalue <= 1.0
  invariant zone = SAFE implies harmrisk <= 0.25
  invariant zone = CAUTION implies harmrisk > 0.25
  invariant zone = CAUTION implies harmrisk < 0.60
  invariant zone = EXCLUDE implies harmrisk >= 0.60
  invariant fogmediastate = UNKNOWN_MEDIA implies zone = EXCLUDE
endparticle
