aln2-spec "phoenix-hex-inverse-invariant-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle phoenix.hexAnchorInverseAudit {
  id: "PHX-HEX-INVERSE-AUDIT-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    coordinateOffset: integer
    radixK: integer
    q: integer
    r: integer
    s: integer
    linearAnchorId: integer
    transformMethod: string

  require:
    coordinateOffset >= 0
    radixK > coordinateOffset * 2
    q >= -coordinateOffset
    q <= coordinateOffset
    r >= -coordinateOffset
    r <= coordinateOffset
    s = -q - r
    linearAnchorId >= 0
    transformMethod = "LINEAR_OFFSET_RADIX_CUBE_COORDINATES"

  invariant:
    s = -q - r
    linearAnchorId = (q + coordinateOffset)
      + radixK * (r + coordinateOffset)
    (linearAnchorId mod radixK) - coordinateOffset = q
    (
      (linearAnchorId - (linearAnchorId mod radixK)) / radixK
    ) - coordinateOffset = r
    -(
      (linearAnchorId mod radixK) - coordinateOffset
    ) - (
      (
        (linearAnchorId - (linearAnchorId mod radixK)
      ) / radixK
    ) - coordinateOffset
    ) = s
    transformMethod = "LINEAR_OFFSET_RADIX_CUBE_COORDINATES"

  rule inverse.bijective {
    require:
      (linearAnchorId mod radixK) - coordinateOffset = q
      && (
        (linearAnchorId - (linearAnchorId mod radixK)) / radixK
      ) - coordinateOffset = r

    effect:
      report:
        status: "INVERSE_BIJECTION_SATISFIED"
        reason: "The declared linear coordinate transform decodes exactly to its bounded cube anchor"
  }
}
