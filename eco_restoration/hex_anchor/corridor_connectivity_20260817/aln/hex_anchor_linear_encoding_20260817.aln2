aln2-spec "hex-anchor-linear-encoding-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle phoenix.hexAnchorLinearEncoding {
  id: "PHX-HEX-LINEAR-ENCODING-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    coordinateOffset: integer
    radixK: integer
    q: integer
    r: integer
    s: integer
    linearAnchorId: integer

  require:
    coordinateOffset >= 0
    radixK > coordinateOffset * 2
    q >= -coordinateOffset
    q <= coordinateOffset
    r >= -coordinateOffset
    r <= coordinateOffset
    s = -q - r
    linearAnchorId >= 0

  invariant:
    s = -q - r
    linearAnchorId = (q + coordinateOffset)
      + radixK * (r + coordinateOffset)
    (linearAnchorId mod radixK) = q + coordinateOffset
    (linearAnchorId - (linearAnchorId mod radixK)) / radixK = r + coordinateOffset

  rule encoding.reversible {
    require:
      linearAnchorId = (q + coordinateOffset)
        + radixK * (r + coordinateOffset)

    effect:
      report:
        status: "REVERSIBLE_LINEAR_ENCODING"
        reason: "The identifier is arithmetic packing of bounded coordinates, not a cryptographic hash"
  }
}
