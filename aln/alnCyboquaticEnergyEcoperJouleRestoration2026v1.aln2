# filename: aln/alnCyboquaticEnergyEcoperJouleRestoration2026v1.aln2

aln2-spec cyboquatic-energy-ecoperjoule-restoration-2026v1
version 2
license MIT OR Apache-2.0

did-root primary bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
alternate bostrom1ldgmtf20d6604a24ztr0jxht7xt7az4jhkmsrc

particle cyboquatic.energy.ecoperjoule.restoration
  id cyboquatic.energy.ecoperjoule.restoration.2026.v1
  did bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7

  domain CYBOQUATIC
  subdomain ENERGYRESTORATION
  phoenix-anchor PHXENERGYRESTORATIONCYBOQUATIC2026

  ker-axis
    knowledge k in 0.0, 1.0
    ecoImpact e in 0.0, 1.0
    risk r in 0.0, 1.0
    kerScore k e - r

  field
    frameId           hex256
    nodeId            text
    dateUtc           text
    windowStartUtc    text
    windowEndUtc      text

    energyReqJ        float
    ecoperJoule       float
    restorationFlag   bool
    carbonNegativeOk  bool

    k                 float
    e                 float
    r                 float
    kerScore          float

    evidenceHex       hex256
    signingDid        text

rule energy.ecoperjoule.restoration.accept
  input
    frameId           hex256
    nodeId            text
    dateUtc           text
    windowStartUtc    text
    windowEndUtc      text
    energyReqJ        float
    ecoperJoule       float
    restorationFlag   bool
    carbonNegativeOk  bool
    k                 float
    e                 float
    r                 float
    kerScore          float
    evidenceHex       hex256
    signingDid        text

  require
    ecoperJoule 0.0 ecoperJoule 1000.0
    k 0.0 k 1.0
    e 0.0 e 1.0
    r 0.0 r 1.0
    kerScore k e - r 0.000001
    carbonNegativeOk true

  effect
    hexstamp
      owner bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
      frame frameId
      node nodeId
      window windowStartUtc windowEndUtc
      energy energyReqJ ecoperJoule
      restoration restorationFlag
      carbonNegative carbonNegativeOk
      ker k k e e r r score kerScore
      evidence evidenceHex
      signer signingDid
