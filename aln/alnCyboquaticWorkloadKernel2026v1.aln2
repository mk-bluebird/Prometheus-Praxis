# filename: aln/alnCyboquaticWorkloadKernel2026v1.aln2
# license: MIT OR Apache-2.0
# role: ALN v2 particle for main cyboquatic workload kernel slices.

aln2-spec cyboquatic-workload-kernel-2026v1
version 2
license MIT OR Apache-2.0

did-root primary bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
alternate bostrom1ldgmtf20d6604a24ztr0jxht7xt7az4jhkmsrc

particle cyboquatic.workload.kernel
  id cyboquatic.workload.kernel.2026.v1
  did bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7

  domain CYBOQUATIC
  subdomain WORKLOADENERGYDV
  phoenix-anchor PHXWORKLOADENGINE20260709

  ker-axis
    knowledge k in 0.0, 1.0
    ecoImpact e in 0.0, 1.0
    risk r in 0.0, 1.0
    kerScore k e - r

  field
    nodeId          text
    dateUtc         text            -- YYYY-MM-DD
    windowStartUtc  text            -- ISO8601
    windowEndUtc    text            -- ISO8601
    domainCode      text            -- 'a'..'g'
    subtaskId       text

    energyReqJ      float
    throughputM3    float
    headM           float
    dutyCycle       float           -- [0,1]

    vtCurrent       float
    vtNext          float
    vtDelta         float

    k               float           -- k in [0,1]
    e               float           -- e in [0,1]
    r               float           -- r in [0,1]
    kerScore        float           -- k e - r

    lane            text            -- RESEARCH/PILOT/PRODUCTION
    safeToPromote   bool

    evidenceHex     hex256
    signingDid      text

rule workload.kernel.accept
  input
    nodeId          text
    dateUtc         text
    windowStartUtc  text
    windowEndUtc    text
    domainCode      text
    subtaskId       text
    energyReqJ      float
    throughputM3    float
    headM           float
    dutyCycle       float
    vtCurrent       float
    vtNext          float
    vtDelta         float
    k               float
    e               float
    r               float
    kerScore        float
    lane            text
    safeToPromote   bool
    evidenceHex     hex256
    signingDid      text

  require
    dutyCycle 0.0 dutyCycle 1.0
    k 0.0 k 1.0
    e 0.0 e 1.0
    r 0.0 r 1.0
    kerScore k e - r 0.000001
    vtDelta vtNext - vtCurrent 0.000001

  effect
    hexstamp
      owner bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
      node nodeId
      date dateUtc
      window windowStartUtc windowEndUtc
      domain domainCode
      subtask subtaskId
      lane lane
      ker k k e e r r score kerScore
      vt vtCurrent vtNext vtDelta
      evidence evidenceHex
      signer signingDid
