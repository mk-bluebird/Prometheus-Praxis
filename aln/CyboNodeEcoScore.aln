# filename: aln/CyboNodeEcoScore.aln
# destination: Prometheus-Praxis/aln/CyboNodeEcoScore.aln
# license: MIT OR Apache-2.0

alnversion 1.0
schema CyboNodeEcoScoreV1
title Cyboquatic Node EcoScore Shard
shardfamily CyboNodeEcoScore
bostromdid bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7

# Identity
field shardid String
field nodeid String
field regionid String
field schemaid String
field repoid String
field timestart String
field timeend String

# Plane-level residuals and weights
field rcarbon Float
field rbiodiversity Float
field rrestoration Float
field renergy Float
field rhydrology Float
field rtopology Float
field rsigma Float

# Canonical weights and non-offsettable flags (resolved from plane-weights crate)
field wcarbon Float
field wbiodiversity Float
field wrestoration Float
field wenergy Float
field whydrology Float
field wtopology Float
field wsigma Float

field carbon_nonoffsettable Bool
field biodiversity_nonoffsettable Bool

# Lyapunov residual and KER scores
field vt Float
field kerk Float
field kere Float
field kerr Float

# Governance fields
field lane String        # RESEARCH | EXP | PROD
field rewardeligible Bool
field rationale String
field signingdid String
field evidencehex String

admissibilityrules
    rcarbon 0.0 1.0
    rbiodiversity 0.0 1.0
    rrestoration 0.0 1.0
    renergy 0.0 1.0
    rhydrology 0.0 1.0
    rtopology 0.0 1.0
    rsigma 0.0 1.0

    wcarbon 0.0 1.0
    wbiodiversity 0.0 1.0
    wrestoration 0.0 1.0
    wenergy 0.0 1.0
    whydrology 0.0 1.0
    wtopology 0.0 1.0
    wsigma 0.0 1.0

    vt nonan
    kerk 0.0 1.0
    kere 0.0 1.0
    kerr 0.0 1.0
endadmissibilityrules

# Risk aggregation mapping: coordinates + plane weights -> residual and KER.
riskmapping node_residual_and_ker
    derivedinrust ecosafety-core::compute_node_residual_and_ker
    targetcoordinates vt, kerk, kere, kerr
endriskmapping

# Invariants enforcing frozen plane weights and non-offsettable semantics.
constraint NonOffsettablePlanes
    # If carbon or biodiversity residuals are outside corridor bounds, EcoScore is unsafe.
    require rcarbon PlaneWeightsRow.carbon.corridormax
    require rbiodiversity PlaneWeightsRow.biodiversity.corridormax
endconstraint

constraint KERBandsForReward
    # Reward eligibility only if KER is within target bands.
    require kerk 0.90
    require kere 0.90
    require kerr 0.13
endconstraint

ecoimpactscores
    knowledgefactor kerk
    ecoimpact kere
    residualrisk kerr
endecoimpactscores

endschema
