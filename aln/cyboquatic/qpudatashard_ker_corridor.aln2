
GOVERNANCE_PARTICLE qpudatashard_ker_canal_node {
    DID_OWNER = "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7";

    STATE canal_node_state {
        k_safe_steps_fraction : [0.0, 1.0];
        e_energy_band : [0.0, 1.0];
        r_risk_max : [0.0, 1.0];
        ker_score : real;
        deltaVt : [0.0, 1.0];
    }

    INVARIANT ker_positive_implies_deltaVt_decrease {
        FOR ALL t:
            IF canal_node_state.ker_score(t) > 0.0 THEN
                canal_node_state.deltaVt(t+1) <= canal_node_state.deltaVt(t);
    }

    INVARIANT cold_survival_pfascorridor_non_increasing_mass {
        FOR ALL t:
            canal_node_state.r_risk_max(t+1) <= canal_node_state.r_risk_max(t);
    }

    TRANSITION update_from_sql_telemetry {
        INPUT sql_row {
            energyreqJ : real;
            energy_input_J : real;
            deltaVt : real;
            topo_stress_norm : real;
        }

        EFFECT {
            canal_node_state.e_energy_band' = min(1.0, energy_input_J / 5000000.0);
            canal_node_state.r_risk_max' = max(canal_node_state.r_risk_max, topo_stress_norm);
            canal_node_state.deltaVt' = deltaVt;
            canal_node_state.ker_score' =
                canal_node_state.k_safe_steps_fraction * canal_node_state.e_energy_band' -
                canal_node_state.r_risk_max';
        }
    }
}
