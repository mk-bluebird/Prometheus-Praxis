
GOVERNANCE_PARTICLE eco_multilang_binding {
    DID_OWNER = "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7";

    STATE binding_state {
        cpp_binding_safe      : [0.0, 1.0];
        kotlin_binding_safe   : [0.0, 1.0];
        java_binding_safe     : [0.0, 1.0];
        lua_binding_safe      : [0.0, 1.0];
        ker_semantics_preserved : [0.0, 1.0];
    }

    INVARIANT non_actuating_bindings {
        FOR ALL t:
            cpp_binding_safe(t)   = 1.0 AND
            kotlin_binding_safe(t) = 1.0 AND
            java_binding_safe(t)   = 1.0 AND
            lua_binding_safe(t)    = 1.0;
    }

    INVARIANT ker_semantics_consistency {
        FOR ALL t:
            ker_semantics_preserved(t) = 1.0;
    }

    TRANSITION register_cpp_binding {
        INPUT cpp_module {
            relpath : text;
            toolname : text;
        }

        EFFECT {
            cpp_binding_safe' = 1.0;
            ker_semantics_preserved' = 1.0;
        }
    }

    TRANSITION register_kotlin_binding {
        INPUT kotlin_module {
            classname : text;
        }

        EFFECT {
            kotlin_binding_safe' = 1.0;
            ker_semantics_preserved' = 1.0;
        }
    }

    TRANSITION register_java_binding {
        INPUT java_module {
            classname : text;
        }

        EFFECT {
            java_binding_safe' = 1.0;
            ker_semantics_preserved' = 1.0;
        }
    }

    TRANSITION register_lua_binding {
        INPUT lua_script {
            relpath : text;
        }

        EFFECT {
            lua_binding_safe' = 1.0;
            ker_semantics_preserved' = 1.0;
        }
    }
}
