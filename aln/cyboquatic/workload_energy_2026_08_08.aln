particle cyboquatic_workload_energy {
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7";
  node_id: text;
  canal_node: text;
  fog_media: text;
  energyreqJ: decimal;
  deltaVt: decimal;
  K: decimal;
  E: decimal;
  R: decimal;
  renewable_fraction: decimal;
  knowledge_factor: decimal;
  eco_impact_value: decimal;

  invariant energyreqJ >= 0;
  invariant deltaVt >= 0 and deltaVt <= 0.25;
  invariant K >= 0 and K <= 1;
  invariant E >= 0 and E <= 1;
  invariant R >= 0 and R <= 1;
  invariant renewable_fraction >= 0.70 and renewable_fraction <= 1;
  invariant K * E > R;
  invariant knowledge_factor >= 0 and knowledge_factor <= 1;
  invariant eco_impact_value >= 0 and eco_impact_value <= 1;
}
