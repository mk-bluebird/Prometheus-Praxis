# Filename: aln/blast_radius_scaling.aln2
# Destination: Prometheus-Praxis/aln/blast_radius_scaling.aln2
# License: MIT OR Apache-2.0

aln2-spec blast-radius-scaling-2026-v1
version 2
license MIT OR Apache-2.0

did-root primary bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7

particle blast.radius.event
  field eventId           text
  field nodeId            text
  field rhoKgM3           float
  field gMs2              float
  field surchargeHeadM    float
  field channelWidthM     float
  field channelDepthM     float
  field channelLengthM    float
  field velocityMps       float
  field fogConfinement    float
  field radiusOvertopM    float
  field radiusScourM      float
  field eStar             float
  field rStarOvertop      float
  field rStarScour        float
  field timestampUtc      text
  field evidenceHex       text

  require rhoKgM3 500.0 rhoKgM3 1500.0
  require gMs2 9.0 gMs2 10.0
  require surchargeHeadM 0.0 surchargeHeadM 10.0
  require channelWidthM 0.1 channelWidthM 100.0
  require channelDepthM 0.1 channelDepthM 20.0
  require channelLengthM 1.0 channelLengthM 10000.0
  require velocityMps 0.0 velocityMps 10.0
  require fogConfinement 0.0 fogConfinement 1.0
  require radiusOvertopM 0.0 radiusOvertopM 10000.0
  require radiusScourM 0.0 radiusScourM 10000.0
  require eStar 0.0 eStar 1000.0
  require rStarOvertop 0.0 rStarOvertop 1000.0
  require rStarScour 0.0 rStarScour 1000.0
end

particle blast.radius.masterCurveFit
  field fitId         int
  field corridorId    text
  field aCoefficient  float
  field betaExponent  float
  field sampleCount   int
  field timestampUtc  text
  field evidenceHex   text

  require aCoefficient 0.0 aCoefficient 1.0e9
  require betaExponent 0.0 betaExponent 2.0
  require sampleCount 2 sampleCount 100000
end

rule blast.radius.masterCurveFit.accept
  input fitId        int
        corridorId   text
        aCoefficient float
        betaExponent float
        sampleCount  int
  require sampleCount 10 sampleCount 100000
  effect hexstamp owner bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
         corridor corridorId
         fit fitId
         a aCoefficient
         beta betaExponent
end
