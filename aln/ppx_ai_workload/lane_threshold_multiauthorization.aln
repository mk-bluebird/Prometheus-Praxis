// File: aln/ppx_ai_workload/lane_threshold_multiauthorization.aln
module ppx_lane_threshold_multiauthorization_v2

record governance_particle {
  owner_did: text
  policy_id: text
  k_min: decimal
  e_min: decimal
  r_max: decimal
  policy_version: integer
}

record threshold_change {
  change_id: text
  owner_did: text
  prior_policy_version: integer
  next_policy_version: integer
  proposed_k_min: decimal
  proposed_e_min: decimal
  proposed_r_max: decimal
  quorum: integer
  approval_1: boolean
  approval_2: boolean
  approval_3: boolean
  authorizer_did_1: text
  authorizer_did_2: text
  authorizer_did_3: text
  authorization_ref_1: text
  authorization_ref_2: text
  authorization_ref_3: text
}

invariant governance_owner {
  governance_particle.owner_did == "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

invariant threshold_bounds {
  threshold_change.proposed_k_min >= 0.0 and threshold_change.proposed_k_min <= 1.0 and
  threshold_change.proposed_e_min >= 0.0 and threshold_change.proposed_e_min <= 1.0 and
  threshold_change.proposed_r_max >= 0.0 and threshold_change.proposed_r_max <= 1.0
}

invariant owner_and_version_binding {
  threshold_change.owner_did == governance_particle.owner_did and
  threshold_change.prior_policy_version == governance_particle.policy_version and
  threshold_change.next_policy_version == governance_particle.policy_version + 1
}

invariant quorum_is_reachable {
  threshold_change.quorum >= 2 and threshold_change.quorum <= 3
}

invariant authorizers_are_distinct {
  threshold_change.authorizer_did_1 != threshold_change.authorizer_did_2 and
  threshold_change.authorizer_did_1 != threshold_change.authorizer_did_3 and
  threshold_change.authorizer_did_2 != threshold_change.authorizer_did_3
}

invariant approvals_have_references {
  (not threshold_change.approval_1 or threshold_change.authorization_ref_1 != "") and
  (not threshold_change.approval_2 or threshold_change.authorization_ref_2 != "") and
  (not threshold_change.approval_3 or threshold_change.authorization_ref_3 != "")
}

invariant two_of_three_authorization {
  (if threshold_change.approval_1 then 1 else 0 end) +
  (if threshold_change.approval_2 then 1 else 0 end) +
  (if threshold_change.approval_3 then 1 else 0 end) >= threshold_change.quorum
}
