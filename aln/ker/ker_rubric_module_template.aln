
spec KerRubricModule {

    // Core identity for a single module or file.
    entity ModuleKerProfile {
        field repo_name       : Text;   // e.g. "Prometheus-Praxis"
        field relpath         : Text;   // e.g. "cpp/tools/eco_synapse_cpp_bridge.cpp"
        field did_owner       : Text;   // e.g. bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
        field steward_did     : Text;   // optional steward or reviewer DID
        field lane_default    : Text;   // "RESEARCH" | "EXPPROD" | "PROD"
        field primary_plane   : Text;   // e.g. "CARBON", "HYDRAULICS", "NEURO"
        field module_role     : Text;   // e.g. "ANALYTIC", "ACTUATION_GATE", "PURE_GOVERNANCE"

        // KER triad: 0.0 .. 1.0
        field ker_k           : Real;   // Knowledge-factor
        field ker_e           : Real;   // Eco-impact
        field ker_r           : Real;   // Risk-of-harm

        // Derived scalar for convenience: s = k * e - r
        field ker_s           : Real;

        // Flags
        field non_actuating   : Bool;   // true if module never touches actuators
        field neuro_flag      : Bool;   // true if module touches neuro/brain identity
        field citizen_ready   : Bool;   // true if ready for augmented citizen surface use

        // Time fields for audit; can mirror SQLite timestamps.
        field created_utc     : Text;
        field updated_utc     : Text;
    }

    // Basic numeric bounds on KER triad.
    invariant KerBounds(ModuleKerProfile m) {
        0.0 <= m.ker_k and m.ker_k <= 1.0 and
        0.0 <= m.ker_e and m.ker_e <= 1.0 and
        0.0 <= m.ker_r and m.ker_r <= 1.0
    }

    // Scalar KER score is consistent with triad.
    invariant KerScalarConsistency(ModuleKerProfile m) {
        m.ker_s = m.ker_k * m.ker_e - m.ker_r
    }

    // Base corridor: positive KER score required for deployment beyond RESEARCH.
    invariant KerPositiveForNonResearch(ModuleKerProfile m) {
        m.lane_default = "RESEARCH" or m.ker_s > 0.0
    }

    // High-risk modules must be explicitly flagged and governed.
    invariant HighRiskGovernance(ModuleKerProfile m) {
        // If risk-of-harm is high, citizen_ready must be false in RESEARCH lanes,
        // and neuro_flag must be surfaced.
        (m.ker_r < 0.7) or (
            m.neuro_flag = true and
            m.citizen_ready = false and
            m.lane_default = "RESEARCH"
        )
    }

    // Non-actuating modules must declare module_role accordingly.
    invariant NonActuatingRoleConsistency(ModuleKerProfile m) {
        m.non_actuating = true implies (
            m.module_role = "ANALYTIC" or
            m.module_role = "PURE_GOVERNANCE"
        )
    }

    // Governance requirement: PROD lane modules must satisfy stronger constraints.
    invariant ProdLaneGovernance(ModuleKerProfile m) {
        m.lane_default != "PROD" or (
            m.citizen_ready = true and
            m.non_actuating = false and
            m.ker_s > 0.2 and
            m.ker_e >= 0.7 and
            m.ker_r <= 0.5
        )
    }

    // View binding a KER profile to an MCP file/tool row.
    // This assumes mcp_file/mcp_tool store compatible fields.
    view ModuleKerToMcp(ModuleKerProfile m) {
        KerBounds(m) and
        KerScalarConsistency(m) and
        NonActuatingRoleConsistency(m) and
        KerPositiveForNonResearch(m) and
        ProdLaneGovernance(m) and
        HighRiskGovernance(m)
    }
}
