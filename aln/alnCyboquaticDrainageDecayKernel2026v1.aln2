# filename: aln/alnCyboquaticDrainageDecayKernel2026v1.aln2
# license: MIT OR Apache-2.0
# role: ALN v2 particle for cyboquatic drainage-decay frames (BOD/TSS/CEC).

aln2-spec cyboquatic-drainagedecay-kernel-2026v1
version 2
license MIT OR Apache-2.0

did-root primary bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
alternate bostrom1ldgmtf20d6604a24ztr0jxht7xt7az4jhkmsrc

particle cyboquatic.drainagedecay.kernel
  id cyboquatic.drainagedecay.kernel.2026.v1
  did bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7

  domain HYDRO
  subdomain DRAINAGEDECAY
  phoenix-anchor PHXDRAINAGEDECAYENGINE20260708

  ker-axis
    knowledge k in 0.0, 1.0
    ecoImpact e in 0.0, 1.0
    risk r in 0.0, 1.0
    kerScore k e - r

  field
    frameId           hex256
    canalNodeId       text
    kerProfileId      text
    timestampUtc      text

    bodMgL            float       -- 0..80 per schema
    tssMgL            float       -- 0..500 per schema
    cecCmolPerKg      float       -- 0..100 per schema

    frameEnergyJ      float
    deltaVtMps        float       -- -5..5 per schema

    k                 float       -- k in [0,1]
    e                 float       -- e in [0,1]
    r                 float       -- r in [0,1]
    kerScore          float       -- k e - r

    fogRegionId       text
    fogChannelId      text
    governanceParticleHex hex256
    evidenceHex       hex256
    signingDid        text

rule drainagedecay.frame.accept
  input
    frameId           hex256
    canalNodeId       text
    kerProfileId      text
    timestampUtc      text
    bodMgL            float
    tssMgL            float
    cecCmolPerKg      float
    frameEnergyJ      float
    deltaVtMps        float
    k                 float
    e                 float
    r                 float
    kerScore          float
    fogRegionId       text
    fogChannelId      text
    governanceParticleHex hex256
    evidenceHex       hex256
    signingDid        text

  require
    bodMgL 0.0 bodMgL 80.0
    tssMgL 0.0 tssMgL 500.0
    cecCmolPerKg 0.0 cecCmolPerKg 100.0
    frameEnergyJ 0.0 frameEnergyJ 1000000000000.0
    deltaVtMps -5.0 deltaVtMps 5.0

    k 0.0 k 1.0
    e 0.0 e 1.0
    r 0.0 r 1.0
    kerScore 0.0 kerScore 1.0
    kerScore k e - r 0.000001

  effect
    hexstamp
      owner bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
      frame frameId
      canal canalNodeId
      kerProfile kerProfileId
      timestamp timestampUtc
      bod bodMgL
      tss tssMgL
      cec cecCmolPerKg
      energy frameEnergyJ
      deltaVt deltaVtMps
      ker k k e e r r score kerScore
      fogRegion fogRegionId
      fogChannel fogChannelId
      governance governanceParticleHex
      evidence evidenceHex
      signer signingDid
