# ALN v2 Governance Particle: Cyboquatic Workload KER Corridor
# Bound DID: bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7

particle cyboquatic.workload.ker {
    did_owner = "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7";

    scope {
        domain    = "CYBOQUATIC";
        subdomain = "WORKLOAD_ENERGY_DV";
        registry  = "phoenix_hex_registry";
    }

    plane hydraulics {
        coordinate = "risk_h";
        corridor {
            gold            = [0.0, 0.4];
            amber           = [0.4, 0.7];
            red             = [0.7, 1.0];
            non_offsettable = true;
        }
    }

    plane energy {
        coordinate = "risk_e";
        corridor {
            gold            = [0.0, 0.4];
            amber           = [0.4, 0.7];
            red             = [0.7, 1.0];
            non_offsettable = false;
        }
    }

    plane topology {
        coordinate = "risk_t";
        corridor {
            gold            = [0.0, 0.5];
            amber           = [0.5, 0.8];
            red             = [0.8, 1.0];
            non_offsettable = false;
        }
    }

    plane biodiversity {
        coordinate = "risk_b";
        corridor {
            gold            = [0.0, 0.3];
            amber           = [0.3, 0.6];
            red             = [0.6, 1.0];
            non_offsettable = true;
        }
    }

    triad KER {
        K.definition = "fraction_of_planes_not_worsened_in_window";
        E.definition = "eco_impact_value_based_on_energyreqJ_and_residual_risk";
        R.definition = "max_residual_risk_coordinate_after_cycle";

        invariant window {
            K >= 0.5;
            E >= 0.4;
            R <= 0.7;
        }

        binding sql {
            database = "eco_restoration_shard.db";
            table    = "workload_cycle";
            key      = "hex_id, canal_node_id";
        }
    }

    window monsoon {
        label = "PHOENIX_MONSOON";
        aggregate {
            K_avg >= 0.6;
            E_avg >= 0.5;
            R_max <= 0.7;
        }
        sql {
            table = "ker_window";
        }
    }
}

spec CyboquaticWorkloadKER {

    entity CanalNodeTelemetry {
        field node_id            : Text;
        field hex_id             : Text;
        field canal_node_id      : Text;
        field flow_rate_m3s      : Real;
        field head_loss_m        : Real;
        field pump_power_kw      : Real;
        field lift_height_m      : Real;
        field water_density_kgm3 : Real;
        field gravity_ms2        : Real;
        field eco_efficiency     : Real;
        field timestamp_seconds  : Real;
    }

    entity WorkloadResult {
        field energyreq_j        : Real;
        field eco_energy_j       : Real;
        field delta_v_t          : Real;
        field ker_k              : Real;
        field ker_e              : Real;
        field ker_r              : Real;
        field risk_h             : Real;
        field risk_e             : Real;
        field risk_t             : Real;
        field risk_b             : Real;
    }

    invariant NonNegativeEnergy(WorkloadResult r) {
        r.energyreq_j >= 0.0 and
        r.eco_energy_j >= 0.0
    }

    invariant KERBounds(WorkloadResult r) {
        0.0 <= r.ker_k and r.ker_k <= 1.0 and
        0.0 <= r.ker_e and r.ker_e <= 1.0 and
        0.0 <= r.ker_r and r.ker_r <= 1.0
    }

    invariant PositiveCorridorScore(WorkloadResult r) {
        r.ker_k * r.ker_e - r.ker_r > 0.0
    }

    invariant LyapunovCorridor(WorkloadResult r) {
        r.delta_v_t >= 0.0 and r.delta_v_t <= 0.05
    }

    invariant PlaneCorridors(WorkloadResult r) {
        0.0 <= r.risk_h and r.risk_h <= 1.0 and
        0.0 <= r.risk_e and r.risk_e <= 1.0 and
        0.0 <= r.risk_t and r.risk_t <= 1.0 and
        0.0 <= r.risk_b and r.risk_b <= 1.0
    }

    view CanalNodeToWorkload(CanalNodeTelemetry t, WorkloadResult r) {
        NonNegativeEnergy(r) and
        KERBounds(r) and
        PositiveCorridorScore(r) and
        LyapunovCorridor(r) and
        PlaneCorridors(r)
    }
}
