# filename: qpudatashards/phoenix.uhi.hex.risk.v1.aln
# destination: https://github.com/mk-bluebird/Prometheus-Praxis/qpudatashards/phoenix.uhi.hex.risk.v1.aln
# license: MIT OR Apache-2.0

shard phoenix.uhi.hex.risk.v1 {

  meta {
    title        "Phoenix UHI Hex Risk Shard v1"
    description  "Normalized UHI triad risk coordinates and composite thermal scalar for Phoenix hexes, grammar-bound to the KER-Lyapunov constitution."
    region       "Phoenix-AZ"
    author_did   "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    aln_id       "aln18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    version      "1.0.0"
    kind         "eco.uhi.hex.risk"
    generator    "ecosafety-core-v2::phoenix_uhi_hex_risk"
  }

  schema HexUhiRiskShard {
    field shard_kind        string   required  # e.g., "phoenix-uhi-hex-risk.v1"
    field hex_id            string   required  # Phoenix hex or tract identifier

    # UHI triad coordinates in [0,1]:
    field r_t               f64      required  # Temperature risk scalar
    field r_c               f64      required  # Vegetation / canopy risk scalar
    field r_a               f64      required  # Air-quality risk scalar

    # Composite thermal risk coordinate in [0,1]:
    field r_thermal         f64      required  # Weighted thermal risk scalar

    # Other planes from RiskVector (may be zero if not yet populated):
    field r_hyd             f64      required  # Hydraulic surcharge risk
    field r_energy          f64      required  # Energy / infrastructure risk
    field r_biodiv          f64      required  # Biodiversity risk
    field r_ai              f64      required  # AI workload / compute risk
  }

  corridors {
    # Temperature risk corridor: 0 best, 1 worst.
    corridor r_t {
      band SAFE   [0.0, 0.30]  weight 1.0
      band GOLD   [0.30, 0.60] weight 1.0
      band HARD   [0.60, 1.00] weight 1.0
    }

    # Vegetation/canopy risk corridor.
    corridor r_c {
      band SAFE   [0.0, 0.25]  weight 1.0
      band GOLD   [0.25, 0.55] weight 1.0
      band HARD   [0.55, 1.00] weight 1.0
    }

    # Air-quality risk corridor.
    corridor r_a {
      band SAFE   [0.0, 0.20]  weight 1.0
      band GOLD   [0.20, 0.50] weight 1.0
      band HARD   [0.50, 1.00] weight 1.0
    }

    # Composite thermal risk corridor.
    corridor r_thermal {
      band SAFE   [0.0, 0.30]  weight 1.0
      band GOLD   [0.30, 0.60] weight 1.5
      band HARD   [0.60, 1.00] weight 2.0
    }

    # Hydraulic risk (placeholder; tuned by drainage-decay frames).
    corridor r_hyd {
      band SAFE   [0.0, 0.25]  weight 1.5
      band GOLD   [0.25, 0.60] weight 2.0
      band HARD   [0.60, 1.00] weight 3.0
    }

    # Energy / infrastructure risk.
    corridor r_energy {
      band SAFE   [0.0, 0.30]  weight 1.0
      band GOLD   [0.30, 0.70] weight 1.5
      band HARD   [0.70, 1.00] weight 2.0
    }

    # Biodiversity risk: non-offsettable emphasis.[file:14]
    corridor r_biodiv {
      band SAFE   [0.0, 0.20]  weight 2.0
      band GOLD   [0.20, 0.50] weight 3.0
      band HARD   [0.50, 1.00] weight 4.0
    }

    # AI workload risk corridor.
    corridor r_ai {
      band SAFE   [0.0, 0.30]  weight 1.0
      band GOLD   [0.30, 0.65] weight 1.5
      band HARD   [0.65, 1.00] weight 2.5
    }
  }

  bindings {
    # Map shard fields into the Lyapunov RiskVector grammar.
    bind r_t        -> riskvector.r_thermal.temp
    bind r_c        -> riskvector.r_thermal.vegetation
    bind r_a        -> riskvector.r_thermal.air
    bind r_thermal  -> riskvector.r_thermal.scalar

    bind r_hyd      -> riskvector.r_hyd
    bind r_energy   -> riskvector.r_energy
    bind r_biodiv   -> riskvector.r_biodiv
    bind r_ai       -> riskvector.r_ai
  }

  governance {
    non_offsettable_planes {
      plane "biodiversity"  field r_biodiv  max 0.50
      plane "carbon"        field r_energy  max 0.60
      plane "neurorights"   field r_ai      max 0.65
    }

    # Shard-level KER metadata for eco-impact scoring.
    ker {
      k_factor 0.95   # Knowledge/experience weight for UHI hex risk in Phoenix.[file:14]
      e_factor 0.94   # Eco-impact/benefit weight.
      r_factor 0.09   # Risk-of-harm weight (triad is mostly diagnostic).
    }

    # Constraints for CI / DefinitionRegistry:
    ci_rules {
      # All risk coordinates must be in [0,1].
      rule "bounds" {
        require 0.0 <= r_t      <= 1.0
        require 0.0 <= r_c      <= 1.0
        require 0.0 <= r_a      <= 1.0
        require 0.0 <= r_thermal<= 1.0
        require 0.0 <= r_hyd    <= 1.0
        require 0.0 <= r_energy <= 1.0
        require 0.0 <= r_biodiv <= 1.0
        require 0.0 <= r_ai     <= 1.0
      }

      # Non-offsettable: CI must fail if any emitted shard violates maxima.
      rule "non-offsettable-enforced" {
        require r_biodiv <= 0.50
        require r_energy <= 0.60
        require r_ai     <= 0.65
      }
    }
  }

  hex_stamp {
    # Hex-anchored signature for authorship and corridor binding.
    author_did    "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    shard_kind    "phoenix-uhi-hex-risk.v1"
    lane_default  "RESEARCH"
    lane_allowed  ["RESEARCH", "EXPPROD"]
  }
}
