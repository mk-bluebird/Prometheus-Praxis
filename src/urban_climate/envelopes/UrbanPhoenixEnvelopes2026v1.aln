shard UrbanPhoenixEnvelopes2026v1 {
    meta {
        shard-id        = "UrbanPhoenixEnvelopes2026v1";
        context         = "PrometheusPraxisPhoenixAridUrbanHeatAirWater";
        created-at-utc  = "2026-08-02T00:00:00Z";
        author-did      = "bostaln18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7";
        governance-ref  = "2b586028-a87b-4194-93b8-f5794c194e8a.md";
        ecology-ref     = "e4ba68f5-edd6-438f-8dff-822a2527b867.md";
    }

    schema UrbanHeatEnvelopePhoenix2026v1 {
        tile-id                       : string;
        sampled-at-utc                : datetime;

        air-temp-c                    : f32;
        mrt-c                         : f32;
        lst-c                         : f32;
        uhi-intensity-c               : f32;

        heat-risk-coordinate          : f32;
        roh-contribution              : f32;
        ecoimpact-heat-score          : f32;

        safe-heat-max-c               : f32;
        safe-heat-window-start-utc    : datetime;
        safe-heat-window-end-utc      : datetime;

        sensor-source                 : string;
        eco-safety-envelope-id        : string;
        ker-envelope-id               : string;
        roh-envelope-id               : string;
    }

    invariant UrbanHeatSafetyInvariantPhoenix2026v1 {
        input : UrbanHeatEnvelopePhoenix2026v1;

        require input.air-temp-c <= input.safe-heat-max-c;
        require input.mrt-c      <= input.safe-heat-max-c + 5.0;

        require 0.0 <= input.heat-risk-coordinate <= 1.0;
        require input.roh-contribution <= 0.30;
    }

    policy BindUrbanHeatToLyapunovPhoenix2026v1 {
        input  : UrbanHeatEnvelopePhoenix2026v1;
        effect : LyapunovUpdate;

        emit LyapunovUpdate {
            plane-id   = "HEAT_PHOENIX_2026";
            coordinate = input.heat-risk-coordinate;
            weight     = 1.0;
        };
    }

    schema AirQualityPlanePhoenix2026v1 {
        tile-id                 : string;
        sampled-at-utc          : datetime;

        ozone-ppb               : f32;
        pm25-ug-per-m3          : f32;
        pm10-ug-per-m3          : f32;
        nox-ppb                 : f32;

        air-risk-coordinate     : f32;
        ecoimpact-air-score     : f32;
        roh-contribution        : f32;

        ozone-max-ppb           : f32;
        pm25-max-ug-per-m3      : f32;
        pm10-max-ug-per-m3      : f32;

        sensor-source           : string;
        eco-safety-envelope-id  : string;
        ker-envelope-id         : string;
        roh-envelope-id         : string;
    }

    invariant AirQualitySafetyInvariantPhoenix2026v1 {
        input : AirQualityPlanePhoenix2026v1;

        require input.ozone-ppb        <= input.ozone-max-ppb;
        require input.pm25-ug-per-m3   <= input.pm25-max-ug-per-m3;
        require input.pm10-ug-per-m3   <= input.pm10-max-ug-per-m3;

        require 0.0 <= input.air-risk-coordinate <= 1.0;
        require input.roh-contribution <= 0.30;
    }

    policy BindAirQualityToLyapunovPhoenix2026v1 {
        input  : AirQualityPlanePhoenix2026v1;
        effect : LyapunovUpdate;

        emit LyapunovUpdate {
            plane-id   = "AIR_QUALITY_PHOENIX_2026";
            coordinate = input.air-risk-coordinate;
            weight     = 1.0;
        };
    }

    schema WaterFluxCoordinatePhoenix2026v1 {
        tile-id                     : string;
        sampled-at-utc              : datetime;

        surface-water-flux-l-per-s  : f32;
        infiltration-rate-mm-per-h  : f32;
        cyboquatic-channel-state    : string;

        soil-salinity-ds-per-m      : f32;
        contaminants-index          : f32;
        soil-moisture-pct           : f32;

        water-risk-coordinate       : f32;
        ecoimpact-water-score       : f32;
        roh-contribution            : f32;

        salinity-max-ds-per-m       : f32;
        contaminants-max-index      : f32;
        soilsync-run-id             : string;
        soilsync-sla-breached       : bool;

        sensor-source               : string;
        eco-safety-envelope-id      : string;
        ker-envelope-id             : string;
        roh-envelope-id             : string;
    }

    invariant WaterFluxSafetyInvariantPhoenix2026v1 {
        input : WaterFluxCoordinatePhoenix2026v1;

        require input.soil-salinity-ds-per-m <= input.salinity-max-ds-per-m;
        require input.contaminants-index     <= input.contaminants-max-index;

        require (not input.soilsync-sla-breached) or (input.water-risk-coordinate >= 0.5);

        require 0.0 <= input.water-risk-coordinate <= 1.0;
        require input.roh-contribution <= 0.30;
    }

    policy BindWaterFluxToLyapunovPhoenix2026v1 {
        input  : WaterFluxCoordinatePhoenix2026v1;
        effect : LyapunovUpdate;

        emit LyapunovUpdate {
            plane-id   = "WATER_FOG_PHOENIX_2026";
            coordinate = input.water-risk-coordinate;
            weight     = 1.0;
        };
    }

    policy BlockNewTasksOnWaterOutOfCorridorPhoenix2026v1 {
        input  : WaterFluxCoordinatePhoenix2026v1;
        effect : list<RestorationTaskUpdate>;

        if input.contaminants-index > input.contaminants-max-index
           or input.soil-salinity-ds-per-m > input.salinity-max-ds-per-m
           or input.soilsync-sla-breached == true
        {
            emit RestorationTaskUpdate {
                tile-id   = input.tile-id;
                new-state = enum {Planned, Queued, PreflightRejected}.PreflightRejected;
                reason    = "WaterOutOfCorridorOrSoilSLA";
            };
        }
    }
}
