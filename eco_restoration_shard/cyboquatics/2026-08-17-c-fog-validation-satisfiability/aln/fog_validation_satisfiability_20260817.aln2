aln2-spec "fog-validation-satisfiability-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle fogRouter.crossValidation {
  id: "PHX-FOG-VALIDATION-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    foldId: integer
    truePositive: integer
    falsePositive: integer
    falseNegative: integer
    trueNegative: integer
    precisionValue: float
    recallValue: float
    f1Value: float

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    foldId >= 0
    truePositive >= 0
    falsePositive >= 0
    falseNegative >= 0
    trueNegative >= 0
    precisionValue >= 0.0
    precisionValue <= 1.0
    recallValue >= 0.0
    recallValue <= 1.0
    f1Value >= 0.0
    f1Value <= 1.0

  rule validation.lowRecall {
    require:
      recallValue < 0.90

    effect:
      report:
        status: "SAFETY_REVIEW_REQUIRED"
        reason: "FOG predicate recall is below the configured safety-screening floor"
  }
}

particle fogRouter.thresholdConjunction {
  id: "PHX-FOG-SAT-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    criterionCount: integer
    passedCriterionCount: integer
    pFog: integer
    minimumNormalizedMargin: float

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    criterionCount >= 1
    passedCriterionCount >= 0
    passedCriterionCount <= criterionCount
    pFog = 0 || pFog = 1

  rule conjunction.satisfied {
    require:
      passedCriterionCount = criterionCount
      && pFog = 1
      && minimumNormalizedMargin >= 0.0

    effect:
      report:
        status: "UNMODELED_MEDIA_THRESHOLD_CONJUNCTION_MET"
        reason: "Every required field-calibrated criterion meets its threshold"
  }

  rule conjunction.unsatisfied {
    require:
      passedCriterionCount < criterionCount
      && pFog = 0

    effect:
      report:
        status: "RETAIN_FOR_SAMPLING_AND_CONTEXT_REVIEW"
        reason: "At least one required criterion is below threshold"
  }
}
