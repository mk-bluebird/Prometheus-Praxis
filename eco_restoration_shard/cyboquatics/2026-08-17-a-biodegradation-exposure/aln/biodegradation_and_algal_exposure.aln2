aln2-spec "biodegradation-and-algal-exposure-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle biodegradation.bodCurve {
  id: "PHX-BIO-IDENT-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    runId: string
    temperatureC: float
    boduMgL: float
    kPerDay: float
    measurementTimeDays: float
    measuredBodMgL: float
    jacobianRank: integer

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    temperatureC >= 0.0
    temperatureC <= 60.0
    boduMgL > 0.0
    kPerDay > 0.0
    measurementTimeDays >= 0.0
    measuredBodMgL >= 0.0
    measuredBodMgL <= boduMgL
    jacobianRank >= 0
    jacobianRank <= 2

  rule identifiability.insufficient {
    require:
      jacobianRank < 2

    effect:
      report:
        status: "COLLECT_MORE_DATA"
        reason: "BODu and k are not locally separated by the supplied sensitivity data"
  }

  rule identifiability.local {
    require:
      jacobianRank = 2

    effect:
      report:
        status: "LOCAL_IDENTIFIABILITY_ONLY"
        reason: "Bias and practical uncertainty still require blank, temperature, and residual review"
  }
}

particle ecotoxicology.timeVaryingAlgalExposure {
  id: "PHX-OECD201-TRAJECTORY-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    runId: string
    muMaxPerHour: float
    substrateMgL: float
    ksMgL: float
    ec50MgL: float
    concentrationMgL: float
    muPerHour: float
    elapsedHours: float

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    muMaxPerHour >= 0.0
    substrateMgL >= 0.0
    ksMgL >= 0.0
    ec50MgL > 0.0
    concentrationMgL >= 0.0
    elapsedHours >= 0.0
    muPerHour >= 0.0

  rule ec50.trajectoryDisclosure {
    require:
      concentrationMgL >= 0.0

    effect:
      report:
        status: "TRAJECTORY_DEPENDENT"
        reason: "A changing concentration path does not yield a constant-exposure EC50 interpretation"
  }
}
