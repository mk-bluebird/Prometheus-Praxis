aln2-spec "qpudatashard-residual-corridor-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle qpudatashard.canalResidual {
  id: "PHX-QPU-RESIDUAL-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    sensorId: string
    observationAvailable: boolean
    priorCovariance: float
    measurementVariance: float
    observationGainH: float
    innovationResidual: float
    innovationVarianceS: float
    kalmanGain: float
    normalizedResidual: float
    whitenessLag1: float

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    priorCovariance >= 0.0
    measurementVariance > 0.0
    observationGainH != 0.0
    innovationVarianceS > 0.0
    whitenessLag1 >= -1.0
    whitenessLag1 <= 1.0

  rule residual.dropout {
    require:
      observationAvailable = false

    effect:
      report:
        status: "PREDICTION_ONLY"
        reason: "No Kalman measurement update and no innovation whitening sample during sensor dropout"
  }

  rule residual.review {
    require:
      observationAvailable = true && abs(whitenessLag1) > 0.20

    effect:
      report:
        status: "MODEL_REVIEW"
        reason: "Lag-one normalized innovation correlation exceeds screening threshold"
  }
}

particle qpudatashard.boundedRlsCorridor {
  id: "PHX-RLS-CORRIDOR-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    phi: float
    observationY: float
    thetaPrior: float
    thetaPosterior: float
    covariancePrior: float
    covariancePosterior: float
    forgettingFactor: float
    residual: float
    gain: float
    gainBound: float
    corridorRadius: float
    persistentExcitationEvidence: float

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    covariancePrior > 0.0
    covariancePosterior > 0.0
    forgettingFactor > 0.0
    forgettingFactor <= 1.0
    gainBound >= 0.0
    abs(gain) <= gainBound
    corridorRadius > 0.0
    persistentExcitationEvidence >= 0.0
    persistentExcitationEvidence <= 1.0

  rule calibration.insufficientExcitation {
    require:
      persistentExcitationEvidence < 0.50

    effect:
      report:
        status: "HOLD_CORRIDOR"
        reason: "Bounded gain is available but parameter convergence is not established without sufficient excitation"
  }

  rule calibration.bounded {
    require:
      persistentExcitationEvidence >= 0.50 && abs(gain) <= gainBound

    effect:
      report:
        status: "SCREENING_BOUND_SATISFIED"
        reason: "Use as non-actuating calibration support with bounded covariance and residual checks"
  }
}
