aln2-spec "hex-exposure-zoning-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle cyboquatic.hexExposureZone {
  id: "PHX-HEX-EXPOSURE-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    canalNodeId: string
    phoenixHexAnchor: string
    measuredDistanceM: float
    conservativeRadiusM: float
    zone: string

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    measuredDistanceM >= 0.0
    conservativeRadiusM > 0.0
    zone = "SAFE" || zone = "CAUTION" || zone = "EXCLUDE"

  invariant:
    zone = "SAFE" implies measuredDistanceM > conservativeRadiusM
    zone = "CAUTION" implies measuredDistanceM > conservativeRadiusM / 2.0
    zone = "CAUTION" implies measuredDistanceM <= conservativeRadiusM
    zone = "EXCLUDE" implies measuredDistanceM <= conservativeRadiusM / 2.0

  rule exposure.safe {
    require:
      zone = "SAFE"
      && measuredDistanceM > conservativeRadiusM

    effect:
      report:
        status: "SAFE"
        reason: "Measured node distance exceeds the conservative radius"
  }

  rule exposure.exclude {
    require:
      zone = "EXCLUDE"
      && measuredDistanceM <= conservativeRadiusM / 2.0

    effect:
      report:
        status: "EXCLUDE"
        reason: "Measured node distance is within the high-concern inner radius"
  }
}
