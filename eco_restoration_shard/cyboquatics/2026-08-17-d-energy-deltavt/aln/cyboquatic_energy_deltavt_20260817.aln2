aln2-spec "cyboquatic-energy-deltavt-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle cyboquatic.workloadEnergy {
  id: "PHX-ENERGYREQ-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    forceN: float
    distanceM: float
    drivetrainEfficiency: float
    energyreqJ: float
    groundPressurePa: float
    adjustedAllowablePressurePa: float
    bankSensitivity: float

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    forceN >= 0.0
    distanceM >= 0.0
    drivetrainEfficiency > 0.0
    drivetrainEfficiency <= 1.0
    energyreqJ >= 0.0
    groundPressurePa >= 0.0
    adjustedAllowablePressurePa > 0.0
    bankSensitivity >= 0.0
    bankSensitivity <= 1.0

  rule workload.rejectPressure {
    require:
      groundPressurePa > adjustedAllowablePressurePa

    effect:
      report:
        status: "REJECT_GROUND_PRESSURE"
        reason: "Equipment demand exceeds bank-sensitivity-adjusted bearing capacity"
  }
}

particle cyboquatic.deltaVt {
  id: "PHX-DELTAVT-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    integratedDeltaVt: float
    siteDeltaVtLimit: float
    withinSiteLimit: boolean

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    siteDeltaVtLimit > 0.0
    siteDeltaVtLimit <= 10000.0
    abs(integratedDeltaVt) <= 10000.0

  rule deltaVt.siteLimit {
    require:
      abs(integratedDeltaVt) > siteDeltaVtLimit

    effect:
      report:
        status: "HOLD_FOR_SITE_REVIEW"
        reason: "Integrated velocity change exceeds the equipment-specific site limit"
  }
}
