aln2-spec "fog-hysteresis-uncertainty-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle fogRouter.hysteresis {
  id: "PHX-FOG-HYSTERESIS-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    priorPFog: integer
    priorScore: float
    currentScore: float
    deltaScore: float
    uncertaintySigma: float
    effectiveDelta: float
    switchApplied: boolean
    safetyViolation: boolean

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    priorPFog = 0 || priorPFog = 1
    deltaScore >= 0.0
    uncertaintySigma >= 0.0
    effectiveDelta >= deltaScore

  rule hysteresis.hold {
    require:
      abs(currentScore - priorScore) <= effectiveDelta
      && safetyViolation = false

    effect:
      report:
        status: "HOLD_PREVIOUS_ROUTE"
        reason: "Score change is within uncertainty-aware hysteresis width"
  }

  rule hysteresis.safety {
    require:
      safetyViolation = true

    effect:
      report:
        status: "MANUAL_FIELD_REVIEW"
        reason: "Safety evidence overrides ordinary hysteresis holding"
  }
}

particle fogRouter.uncertainty {
  id: "PHX-FOG-UNCERTAINTY-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    margin: float
    sigmaMargin: float
    lowerMargin: float
    upperMargin: float
    pFog: integer

  ker-axis {
    knowledge: k in [0.0, 1.0]
    ecoImpact: e in [0.0, 1.0]
    risk: r in [0.0, 1.0]
    kerScore: k * (e - r)
  }

  require:
    sigmaMargin >= 0.0
    lowerMargin <= upperMargin
    pFog = 0 || pFog = 1

  rule uncertainty.indeterminate {
    require:
      lowerMargin <= 0.0 && upperMargin >= 0.0

    effect:
      report:
        status: "INDETERMINATE_MANUAL_FIELD_REVIEW"
        reason: "Measurement uncertainty overlaps the FOG predicate boundary"
  }

  rule uncertainty.confirmed {
    require:
      lowerMargin > 0.0 && pFog = 1

    effect:
      report:
        status: "FOG_CONFIRMED_WITHIN_MARGIN_INTERVAL"
        reason: "The full margin interval is above the FOG decision boundary"
  }
}
