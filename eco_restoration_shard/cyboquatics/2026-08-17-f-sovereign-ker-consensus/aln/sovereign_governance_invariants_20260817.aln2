aln2-spec "sovereign-governance-invariants-2026-08-17" {
  version: 2
  license: "MIT OR Apache-2.0"
}

did-root {
  primary: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
}

particle governance.sovereignInvariant {
  id: "PHX-SOVEREIGN-INVARIANT-20260817"
  did: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  maintainerDid: "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"

  input:
    ownerDid: string
    governanceQuorum: integer
    proposedGovernanceQuorum: integer
    safeRiskMaximum: float
    cautionRiskMinimumExclusive: float
    cautionRiskMaximumExclusive: float
    excludeRiskMinimum: float
    proposedOwnerDid: string
    proposedSafeRiskMaximum: float
    proposedCautionRiskMinimumExclusive: float
    proposedCautionRiskMaximumExclusive: float
    proposedExcludeRiskMinimum: float
    sovereignAuthorizationDid: string
    sovereignAuthorizationPresent: boolean

  require:
    ownerDid = "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    governanceQuorum >= 1
    proposedGovernanceQuorum >= 1
    safeRiskMaximum = 0.25
    cautionRiskMinimumExclusive = 0.25
    cautionRiskMaximumExclusive = 0.60
    excludeRiskMinimum = 0.60
    safeRiskMaximum >= 0.0
    excludeRiskMinimum <= 1.0
    safeRiskMaximum = cautionRiskMinimumExclusive
    cautionRiskMaximumExclusive = excludeRiskMinimum
    proposedOwnerDid = ownerDid
    proposedSafeRiskMaximum = safeRiskMaximum
    proposedCautionRiskMinimumExclusive = cautionRiskMinimumExclusive
    proposedCautionRiskMaximumExclusive = cautionRiskMaximumExclusive
    proposedExcludeRiskMinimum = excludeRiskMinimum

  invariant:
    ownerDid = "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    safeRiskMaximum = 0.25
    cautionRiskMinimumExclusive = 0.25
    cautionRiskMaximumExclusive = 0.60
    excludeRiskMinimum = 0.60
    safeRiskMaximum = cautionRiskMinimumExclusive
    cautionRiskMaximumExclusive = excludeRiskMinimum
    proposedOwnerDid = ownerDid
    proposedSafeRiskMaximum = safeRiskMaximum
    proposedCautionRiskMinimumExclusive = cautionRiskMinimumExclusive
    proposedCautionRiskMaximumExclusive = cautionRiskMaximumExclusive
    proposedExcludeRiskMinimum = excludeRiskMinimum

  rule governance.quorumChange {
    require:
      proposedGovernanceQuorum != governanceQuorum

    effect:
      report:
        status: "SOVEREIGN_AUTHORIZATION_REQUIRED"
        reason: "Quorum changes require an authorization attested by the immutable owner DID"
  }

  rule governance.quorumAuthorization {
    require:
      proposedGovernanceQuorum != governanceQuorum
      && sovereignAuthorizationPresent = true
      && sovereignAuthorizationDid = ownerDid

    effect:
      report:
        status: "SOVEREIGN_AUTHORIZATION_PRESENT"
        reason: "The proposed quorum change carries the required sovereign authorization identity"
  }

  rule governance.rejectUnauthorizedChange {
    require:
      proposedGovernanceQuorum != governanceQuorum
      && (
        sovereignAuthorizationPresent = false
        || sovereignAuthorizationDid != ownerDid
      )

    effect:
      report:
        status: "REJECT_UNAUTHORIZED_GOVERNANCE_CHANGE"
        reason: "The owner DID, thresholds, and quorum cannot be changed without explicit sovereign authorization"
  }
}
