lane_rules
  lane RESEARCH
    when delta_vt > 0.00
      or k_metric < 0.80
      or e_metric < 0.80
      or r_metric > 0.20
  endlane

  lane PILOT
    when delta_vt <= 0.00
      and k_metric >= 0.80
      and e_metric >= 0.80
      and r_metric <= 0.20
  endlane

  lane PRODUCTION
    when delta_vt <= 0.00
      and k_metric >= 0.95
      and e_metric >= 0.95
      and r_metric <= 0.10
  endlane
endlane_rules

