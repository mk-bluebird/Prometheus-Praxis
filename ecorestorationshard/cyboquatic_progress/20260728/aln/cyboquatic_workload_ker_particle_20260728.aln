kertriad
  k_min 0.80
  e_min 0.80
  r_max 0.20
endkertriad

corridorspec
  r_energy_max 1.00
  delta_vt_max 0.00
  canal_velocity_band 0.30,0.70
  sensor_health_risk_max 0.20
