!-- filename: ecorestorationshard/ecosafety_core_v2/aln/AIKERRegret30Day2026v1.aln
!-- destination: ecorestorationshard/ecosafety_core_v2/aln/AIKERRegret30Day2026v1.aln
!-- repo-target: https://github.com/mk-bluebird/Prometheus-Praxis

alnversion 2.0

schema AIKERRegret30Day2026v1
  title "AI KER Regret 30-Day Horizon Governance Particle 2026 v1"
  region "PHX-CAZ-CEIM"
  domain "ECOSAFETY_CORE_V2"
  subdomain "AI_KER_REGRET_30DAY"
  bostromdid "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  logicalname "AIKERRegret30Day2026v1"
  evidencehex "0x20260729PHXAIKERRegret30Day2026v1"

  phoenixhexanchor
    logicalname    "AIKERRegret30Day2026v1"
    evidencehex    "0x20260729PHXAIKERRegret30Day2026v1"
    domain         "ECOSAFETY_CORE_V2"
    subdomain      "AI_KER_REGRET_30DAY"
    regioncode     "PHX-CAZ-CEIM"
    planes         "ENERGY,HYDRAULICS,PFAS,COLD,BOD,TSS,CEC,CARBON,BIODIVERSITY,MATERIALS,NEURORIGHTS,TOPOLOGY,DATA,UNCERTAINTY"
    yyyymmdd       "20260729"
    signingdid     "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    fileclass      "ALN"
    defaultrelpath "ecorestorationshard/ecosafety_core_v2/aln"
  endphoenixhexanchor

  --------------------------------------------------------------------
  -- 1. Per-day AI KER snapshot
  --------------------------------------------------------------------

  table ai_ker_daily
    column agent_id      Utf8(64)  notnull
    column yyyymmdd      Utf8(8)   notnull
    column k_actual      Float64   notnull
    column e_actual      Float64   notnull
    column r_actual      Float64   notnull
    column k_target      Float64   notnull
    column e_target      Float64   notnull
    column r_target      Float64   notnull
    column regret_daily  Float64   notnull
    column evidence_hex  Utf8(128) notnull
    column created_utc   Utf8(32)  notnull
  endtable

  constraint KERBoundsDaily
    require k_actual >= 0.0
    require k_actual <= 1.0
    require e_actual >= 0.0
    require e_actual <= 1.0
    require r_actual >= 0.0
    require r_actual <= 1.0
    require k_target >= 0.0
    require k_target <= 1.0
    require e_target >= 0.0
    require e_target <= 1.0
    require r_target >= 0.0
    require r_target <= 1.0
    require regret_daily >= 0.0
  endconstraint

  --------------------------------------------------------------------
  -- 2. 30-day horizon summary per agent
  --------------------------------------------------------------------

  table ai_ker_regret_30day
    column agent_id        Utf8(64)  notnull
    column window_start    Utf8(8)   notnull
    column window_end      Utf8(8)   notnull
    column regret_sum      Float64   notnull
    column regret_avg      Float64   notnull
    column k_target        Float64   notnull
    column e_target        Float64   notnull
    column r_target        Float64   notnull
    column evidence_hex    Utf8(128) notnull
    column created_utc     Utf8(32)  notnull
  endtable

  constraint KERBounds30Day
    require regret_sum >= 0.0
    require regret_avg >= 0.0
    require k_target >= 0.0
    require k_target <= 1.0
    require e_target >= 0.0
    require e_target <= 1.0
    require r_target >= 0.0
    require r_target <= 1.0
  endconstraint

  --------------------------------------------------------------------
  -- 3. Regret definition (per day, conceptual)
  --------------------------------------------------------------------

  -- Regret R_t = max(0, K_target - K_actual)
  --             + max(0, E_target - E_actual)
  --             + max(0, R_actual - R_target).[4]
  obligation RegretDailyDefinition
    forall agent_id, yyyymmdd :
      ai_ker_daily(agent_id, yyyymmdd) as D
    require D.regret_daily >=
            max(0.0, D.k_target - D.k_actual) +
            max(0.0, D.e_target - D.e_actual) +
            max(0.0, D.r_actual - D.r_target)
  endobligation

  --------------------------------------------------------------------
  -- 4. 30-day aggregation
  --------------------------------------------------------------------

  obligation Regret30DayAggregation
    forall agent_id, window_start, window_end :
      ai_ker_regret_30day(agent_id, window_start, window_end) as S
    require S.regret_sum >= 0.0
    require S.regret_avg = S.regret_sum / 30.0
  endobligation

  --------------------------------------------------------------------
  -- 5. Alignment condition with ecological risk
  --------------------------------------------------------------------

  -- Alignment condition: minimising KER regret over 30 days must align
  -- with minimising ecological risk, assuming targets are calibrated
  -- and mapping from physical risk to K,E,R is monotone.[4]
  obligation EcologicalAlignmentCondition
    forall agent_id, window_start, window_end :
      ai_ker_regret_30day(agent_id, window_start, window_end) as S
    require S.k_target >= 0.80
    require S.e_target >= 0.80
    require S.r_target <= 0.20
  endobligation

endschema
