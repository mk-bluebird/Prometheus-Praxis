!-- filename: ecorestorationshard/ecosafety_core_v2/aln/GovStateMachineNonBlocking2026v1.aln
!-- destination: ecorestorationshard/ecosafety_core_v2/aln/GovStateMachineNonBlocking2026v1.aln
!-- repo-target: https://github.com/mk-bluebird/Prometheus-Praxis

alnversion 2.0

schema GovStateMachineNonBlocking2026v1
  title "Non-Blocking Governance State Machine Particle 2026 v1"
  region "PHX-CAZ-CEIM"
  domain "ECOSAFETY_CORE_V2"
  subdomain "GOV_FSM_NONBLOCKING"
  bostromdid "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  logicalname "GovStateMachineNonBlocking2026v1"
  evidencehex "0x20260729PHXGovStateMachineNonBlocking2026v1"

  phoenixhexanchor
    logicalname    "GovStateMachineNonBlocking2026v1"
    evidencehex    "0x20260729PHXGovStateMachineNonBlocking2026v1"
    domain         "ECOSAFETY_CORE_V2"
    subdomain      "GOV_FSM_NONBLOCKING"
    regioncode     "PHX-CAZ-CEIM"
    planes         "ENERGY,HYDRAULICS,PFAS,COLD,BOD,TSS,CEC,CARBON,BIODIVERSITY,MATERIALS,NEURORIGHTS,TOPOLOGY,DATA,UNCERTAINTY"
    yyyymmdd       "20260729"
    signingdid     "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    fileclass      "ALN"
    defaultrelpath "ecorestorationshard/ecosafety_core_v2/aln"
  endphoenixhexanchor

  --------------------------------------------------------------------
  -- 1. Governance states and transitions for KERPathPromotion
  --------------------------------------------------------------------

  table gov_state
    column state_id     Utf8(32)  notnull  -- RESEARCH, PILOT, PROD, BLOCKED, AUTOBANNED
    column is_terminal  Bool      notnull
  endtable

  table gov_transition
    column from_state   Utf8(32)  notnull
    column to_state     Utf8(32)  notnull
    column guard_name   Utf8(64)  notnull  -- reference to a guard over K,E,R
  endtable

  constraint ValidStates
    require inset(state_id, "RESEARCH","PILOT","PROD","BLOCKED","AUTOBANNED")
  endconstraint

  --------------------------------------------------------------------
  -- 2. KER path coupling (KERPathPromotion2026v1)
  --------------------------------------------------------------------

  table gov_ker_path_link
    column path_id     Utf8(64)   notnull
    column state_id    Utf8(32)   notnull
    column k_value     Float64    notnull
    column e_value     Float64    notnull
    column r_value     Float64    notnull
  endtable

  constraint KERBounds
    require k_value >= 0.0
    require k_value <= 1.0
    require e_value >= 0.0
    require e_value <= 1.0
    require r_value >= 0.0
    require r_value <= 1.0
  endconstraint

  -- RESEARCH band constraint for KERPathPromotion2026v1.[4]
  constraint ResearchBand
    require k_value >= 0.80
    require e_value >= 0.80
    require r_value <= 0.20
  endconstraint

  --------------------------------------------------------------------
  -- 3. Non-blocking enabledness: no deadlock for non-terminal states
  --------------------------------------------------------------------

  -- Strongly non-blocking: every non-terminal state must have at least
  -- one outgoing transition.[183][185]
  obligation NonBlockingEnabledness
    forall s :
      gov_state(s) as S
    require not (S.is_terminal = false
                 and not exists t : gov_transition(t)
                       where t.from_state = S.state_id)
  endobligation

  --------------------------------------------------------------------
  -- 4. Guard compatibility with KERPathPromotion monotone steps
  --------------------------------------------------------------------

  -- Guards refer to KER step directions defined in KERPathPromotion2026v1:
  --   G_MONO: k_next >= k_prev, e_next >= e_prev, r_next <= r_prev.[4]
  --   G_PROMOTE_PILOT: same as G_MONO, lane_prev = RESEARCH, lane_next = PILOT.
  --   G_PROMOTE_PROD: stricter thresholds for PROD band.[4]
  table gov_guard
    column guard_name  Utf8(64)   notnull
    column description Utf8(256)  notnull
  endtable

  constraint GuardNames
    require inset(guard_name, "G_MONO","G_PROMOTE_PILOT","G_PROMOTE_PROD",
                              "G_BLOCKED","G_AUTOBANNED")
  endconstraint

  -- Guard compatibility obligation: for any KER step in the RESEARCH band,
  -- at least one guard is satisfiable.[4]
  obligation GuardCompatibilityWithKERPath
    forall path_id :
      ker_path_summary(path_id) as P
    require exists g : gov_guard(g)
            where g.guard_name = "G_MONO"
  endobligation

  --------------------------------------------------------------------
  -- 5. Liveness: AlwaysProgress (no livelock)
  --------------------------------------------------------------------

  -- Liveness: from every state, some transition is reachable when eco-impact
  -- updates occur within corridors, preventing infinite stuttering.[181][192]
  obligation AlwaysProgress
    forall s :
      gov_state(s) as S
    require exists t : gov_transition(t)
            where t.from_state = S.state_id
  endobligation

  --------------------------------------------------------------------
  -- 6. Lane-specific safety constraints
  --------------------------------------------------------------------

  -- No promotion to PROD unless K,E,R satisfy PROD band thresholds.[4]
  obligation ProdBandSafety
    forall path_id, step_index :
      ker_path_step(path_id, step_index) as Step,
      gov_transition(from_state = Step.lane_prev,
                     to_state   = Step.lane_next) as T
    require not (Step.lane_next = "PROD"
                 and (Step.k_next < 0.90
                      or Step.e_next < 0.90
                      or Step.r_next > 0.13))
  endobligation

  -- BLOCKED and AUTOBANNED are terminal in behavior but still non-blocking
  -- in data: they have transitions to self to satisfy enabledness without
  -- allowing further promotion.
  obligation TerminalSelfLoop
    forall s :
      gov_state(s) as S
    require not (S.is_terminal = true
                 and not exists t : gov_transition(t)
                       where t.from_state = S.state_id
                         and t.to_state   = S.state_id)
  endobligation

endschema
