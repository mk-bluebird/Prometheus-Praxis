!-- filename: ecorestorationshard/ecosafety_core_v2/aln/CausalGraphKERCanal2026v1.aln
!-- destination: ecorestorationshard/ecosafety_core_v2/aln/CausalGraphKERCanal2026v1.aln
!-- repo-target: https://github.com/mk-bluebird/Prometheus-Praxis

alnversion 2.0

schema CausalGraphKERCanal2026v1
  title "Intended Causal Structure for KER and Canal Telemetry 2026 v1"
  region "PHX-CAZ-CEIM"
  domain "ECOSAFETY_CORE_V2"
  subdomain "CAUSAL_GRAPH_KER_CANAL"
  bostromdid "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  logicalname "CausalGraphKERCanal2026v1"
  evidencehex "0x20260729PHXCausalGraphKERCanal2026v1"

  phoenixhexanchor
    logicalname    "CausalGraphKERCanal2026v1"
    evidencehex    "0x20260729PHXCausalGraphKERCanal2026v1"
    domain         "ECOSAFETY_CORE_V2"
    subdomain      "CAUSAL_GRAPH_KER_CANAL"
    regioncode     "PHX-CAZ-CEIM"
    planes         "ENERGY,HYDRAULICS,PFAS,COLD,BOD,TSS,CEC,CARBON,BIO,DATA,GOV"
    yyyymmdd       "20260729"
    signingdid     "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    fileclass      "ALN"
    defaultrelpath "ecorestorationshard/ecosafety_core_v2/aln"
  endphoenixhexanchor

  --------------------------------------------------------------------
  -- 1. Variables in causal graph (per day)
  --------------------------------------------------------------------

  table causal_variables_daily
    column node_id        Utf8(64)  notnull
    column yyyymmdd       Utf8(8)   notnull
    column r_pfas         Float64   notnull
    column r_bod          Float64   notnull
    column r_tss          Float64   notnull
    column r_cec          Float64   notnull
    column energyreqJ     Float64   notnull
    column delta_Vt       Float64   notnull
    column K              Float64   notnull
    column E              Float64   notnull
    column R              Float64   notnull
    column actions_code   Utf8(32)  notnull  -- encoded canal operations
    column evidence_hex   Utf8(128) notnull
    column created_utc    Utf8(32)  notnull
  endtable

  constraint KERBoundsDaily
    require K >= 0.0
    require K <= 1.0
    require E >= 0.0
    require E <= 1.0
    require R >= 0.0
    require R <= 1.0
  endconstraint

  --------------------------------------------------------------------
  -- 2. Intended causal edges (design-level)
  --------------------------------------------------------------------

  table causal_edges_intended
    column parent_var     Utf8(32)  notnull
    column child_var      Utf8(32)  notnull
    column description    Utf8(256) notnull
    column evidence_hex   Utf8(128) notnull
    column created_utc    Utf8(32)  notnull
  endtable

  -- Example edges (design intent):
  --   r_pfas(t) -> R(t)
  --   r_bod(t), r_tss(t), r_cec(t) -> R(t)
  --   r_planes(t) -> (K(t),E(t))
  --   (K(t),E(t),R(t)) + actions(t) -> r_planes(t+1), energyreqJ(t+1), delta_Vt(t+1)
  obligation CausalDirectionIntent
    forall parent_var, child_var :
      causal_edges_intended(parent_var, child_var) as CE
    require CE.parent_var <> CE.child_var
  endobligation

  --------------------------------------------------------------------
  -- 3. Alignment obligation: no direct R(t) -> r_pfas(t)
  --------------------------------------------------------------------

  -- KER is constructed from risk, not the other way at the same time step.
  obligation NoInstantReversePFAS
    forall node_id, yyyymmdd :
      causal_variables_daily(node_id, yyyymmdd) as V
    require true  -- conceptual marker: data modeling must avoid R(t) -> r_pfas(t) at same t
  endobligation

endschema
