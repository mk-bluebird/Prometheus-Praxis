!-- filename: ecorestorationshard/ecosafety_core_v2/aln/AutobanCounterfactual2026v1.aln
!-- destination: ecorestorationshard/ecosafety_core_v2/aln/AutobanCounterfactual2026v1.aln
!-- repo-target: https://github.com/mk-bluebird/Prometheus-Praxis

alnversion 2.0

schema AutobanCounterfactual2026v1
  title "Counterfactual Explanations for Governance Particle AUTOBANNED Transitions 2026 v1"
  region "PHX-CAZ-CEIM"
  domain "ECOSAFETY_CORE_V2"
  subdomain "AUTOBAN_COUNTERFACTUAL"
  bostromdid "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  logicalname "AutobanCounterfactual2026v1"
  evidencehex "0x20260729PHXAutobanCounterfactual2026v1"

  phoenixhexanchor
    logicalname    "AutobanCounterfactual2026v1"
    evidencehex    "0x20260729PHXAutobanCounterfactual2026v1"
    domain         "ECOSAFETY_CORE_V2"
    subdomain      "AUTOBAN_COUNTERFACTUAL"
    regioncode     "PHX-CAZ-CEIM"
    planes         "PFAS,COLD,ENERGY,BIO,DATA,GOV"
    yyyymmdd       "20260729"
    signingdid     "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    fileclass      "ALN"
    defaultrelpath "ecorestorationshard/ecosafety_core_v2/aln"
  endphoenixhexanchor

  --------------------------------------------------------------------
  -- 1. AUTOBANNED transition log
  --------------------------------------------------------------------

  table autoban_transition_log
    column particle_id    Utf8(64)  notnull
    column event_index    Int32     notnull
    column r_pfas         Float64   notnull
    column r_cold         Float64   notnull
    column r_energy       Float64   notnull
    column r_bod          Float64   notnull
    column r_tss          Float64   notnull
    column r_cec          Float64   notnull
    column K              Float64   notnull
    column E              Float64   notnull
    column R              Float64   notnull
    column state_prev     Utf8(32)  notnull
    column state_next     Utf8(32)  notnull  -- AUTOBANNED
    column evidence_hex   Utf8(128) notnull
    column created_utc    Utf8(32)  notnull
  endtable

  constraint AutobanState
    require state_next = "AUTOBANNED"
  endconstraint

  --------------------------------------------------------------------
  -- 2. Counterfactual suggestions (DiCE-style)
  --------------------------------------------------------------------

  -- Counterfactual risk coordinates that would keep the particle ACTIVE.
  table autoban_counterfactual_suggestions
    column particle_id       Utf8(64)  notnull
    column event_index       Int32     notnull
    column cf_r_pfas         Float64   notnull
    column cf_r_cold         Float64   notnull
    column cf_r_energy       Float64   notnull
    column cf_r_bod          Float64   notnull
    column cf_r_tss          Float64   notnull
    column cf_r_cec          Float64   notnull
    column cf_state_target   Utf8(32)  notnull  -- e.g. ACTIVE, RESEARCH
    column l1_distance       Float64   notnull  -- sum_j |cf_r_j - r_j|
    column evidence_hex      Utf8(128) notnull
    column created_utc       Utf8(32)  notnull
  endtable

  constraint CFBounds
    require cf_r_pfas   >= 0.0
    require cf_r_pfas   <= 1.0
    require cf_r_cold   >= 0.0
    require cf_r_cold   <= 1.0
    require cf_r_energy >= 0.0
    require cf_r_energy <= 1.0
    require cf_r_bod    >= 0.0
    require cf_r_bod    <= 1.0
    require cf_r_tss    >= 0.0
    require cf_r_tss    <= 1.0
    require cf_r_cec    >= 0.0
    require cf_r_cec    <= 1.0
    require l1_distance >= 0.0
  endconstraint

  --------------------------------------------------------------------
  -- 3. Counterfactual obligation: cf_state_target must avoid AUTOBANNED
  --------------------------------------------------------------------

  obligation AutobanCFValidTarget
    forall particle_id, event_index :
      autoban_counterfactual_suggestions(particle_id, event_index) as CF
    require CF.cf_state_target <> "AUTOBANNED"
  endobligation

endschema
