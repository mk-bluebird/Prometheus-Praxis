!-- filename: ecorestorationshard/ecosafety_core_v2/aln/PFASElectrodeKalman2026v1.aln
!-- destination: ecorestorationshard/ecosafety_core_v2/aln/PFASElectrodeKalman2026v1.aln
!-- repo-target: https://github.com/mk-bluebird/Prometheus-Praxis

alnversion 2.0

schema PFASElectrodeKalman2026v1
  title "PFAS Nernst Electrode Kalman Calibration Governance Particle 2026 v1"
  region "PHX-CAZ-CEIM"
  domain "ECOSAFETY_CORE_V2"
  subdomain "PFAS_ELECTRODE_KALMAN"
  bostromdid "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  logicalname "PFASElectrodeKalman2026v1"
  evidencehex "0x20260729PHXPFASElectrodeKalman2026v1"

  phoenixhexanchor
    logicalname    "PFASElectrodeKalman2026v1"
    evidencehex    "0x20260729PHXPFASElectrodeKalman2026v1"
    domain         "ECOSAFETY_CORE_V2"
    subdomain      "PFAS_ELECTRODE_KALMAN"
    regioncode     "PHX-CAZ-CEIM"
    planes         "PFAS,DATA,UNCERTAINTY,NEURORIGHTS"
    yyyymmdd       "20260729"
    signingdid     "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    fileclass      "ALN"
    defaultrelpath "ecorestorationshard/ecosafety_core_v2/aln"
  endphoenixhexanchor

  --------------------------------------------------------------------
  -- 1. Augmented state for PFAS electrode (concentration + sensitivity)
  --------------------------------------------------------------------

  table pfaselectrode_state
    column node_id        Utf8(64)  notnull
    column timestep       Int32     notnull
    column c_pf           Float64   notnull  -- PFAS concentration estimate
    column s_sens         Float64   notnull  -- electrode sensitivity estimate
    column o_offset       Float64   notnull  -- electrode offset estimate
    column K_knowledge    Float64   notnull  -- K factor in 0..1
    column evidence_hex   Utf8(128) notnull
    column created_utc    Utf8(32)  notnull
  endtable

  constraint StateBounds
    require c_pf     >= 0.0
    require s_sens   >= 0.0
    require K_knowledge >= 0.0
    require K_knowledge <= 1.0
  endconstraint

  --------------------------------------------------------------------
  -- 2. Measurement records (Nernst electrode + standard addition)
  --------------------------------------------------------------------

  table pfaselectrode_measurement
    column node_id        Utf8(64)  notnull
    column timestep       Int32     notnull
    column z_potential    Float64   notnull  -- measured electrode potential
    column added_pf_std   Float64   notnull  -- standard addition (PFAS spike)
    column is_calibration Bool      notnull
    column evidence_hex   Utf8(128) notnull
    column created_utc    Utf8(32)  notnull
  endtable

  --------------------------------------------------------------------
  -- 3. Kalman gain schedule and obligations
  --------------------------------------------------------------------

  table pfaselectrode_kalman_gain
    column node_id        Utf8(64)  notnull
    column timestep       Int32     notnull
    column K_knowledge    Float64   notnull  -- K factor (0..1)
    column K_gain_eff     Float64   notnull  -- effective scalar gain for concentration update
    column evidence_hex   Utf8(128) notnull
    column created_utc    Utf8(32)  notnull
  endtable

  constraint KalmanGainBounds
    require K_gain_eff >= 0.0
    require K_gain_eff <= 1.0
  endconstraint

  -- Obligations:
  --   - When knowledge K is low, K_gain_eff must be higher (more aggressive learning).
  --   - K_gain_eff must remain in a convergence-safe interval [K_min, K_max].
  obligation KalmanGainSchedule
    forall node_id, timestep :
      pfaselectrode_kalman_gain(node_id, timestep) as G
    require G.K_knowledge >= 0.0
    require G.K_knowledge <= 1.0
    require not (G.K_knowledge < 0.5 and G.K_gain_eff < 0.2)
    require not (G.K_knowledge > 0.8 and G.K_gain_eff > 0.6)
  endobligation

endschema
