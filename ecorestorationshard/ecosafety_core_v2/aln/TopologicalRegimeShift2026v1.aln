!-- filename: ecorestorationshard/ecosafety_core_v2/aln/TopologicalRegimeShift2026v1.aln
!-- destination: ecorestorationshard/ecosafety_core_v2/aln/TopologicalRegimeShift2026v1.aln
!-- repo-target: https://github.com/mk-bluebird/Prometheus-Praxis

alnversion 2.0

schema TopologicalRegimeShift2026v1
  title "Topological Regime Shift Detection via Persistent Homology 2026 v1"
  region "PHX-CAZ-CEIM"
  domain "ECOSAFETY_CORE_V2"
  subdomain "TDA_REGIME_SHIFT"
  bostromdid "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  logicalname "TopologicalRegimeShift2026v1"
  evidencehex "0x20260729PHXTDARegimeShift2026v1"

  phoenixhexanchor
    logicalname    "TopologicalRegimeShift2026v1"
    evidencehex    "0x20260729PHXTDARegimeShift2026v1"
    domain         "ECOSAFETY_CORE_V2"
    subdomain      "TDA_REGIME_SHIFT"
    regioncode     "PHX-CAZ-CEIM"
    planes         "ENERGY,HYDRAULICS,PFAS,COLD,BOD,TSS,CEC,CARBON,BIODIVERSITY,MATERIALS,NEURORIGHTS,TOPOLOGY,DATA,UNCERTAINTY"
    yyyymmdd       "20260729"
    signingdid     "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    fileclass      "ALN"
    defaultrelpath "ecorestorationshard/ecosafety_core_v2/aln"
  endphoenixhexanchor

  --------------------------------------------------------------------
  -- 1. Persistent homology summary table (H1)
  --------------------------------------------------------------------

  table tda_regime_shift_h1
    column window_start    Utf8(8)   notnull
    column window_end      Utf8(8)   notnull
    column segment_id      Utf8(64)  notnull   -- segment for which PH was computed (or ALL)
    column birth_scale     Float64   notnull   -- filtration value at birth
    column death_scale     Float64   notnull   -- filtration value at death
    column persistence      Float64   notnull   -- death_scale - birth_scale
    column regime_flag     Utf8(32)  notnull   -- e.g., "STABLE_LOOP","TRANSIENT_LOOP"
    column evidence_hex    Utf8(128) notnull
    column created_utc     Utf8(32)  notnull
  endtable

  constraint PersistenceNonNegative
    require persistence >= 0.0
  endconstraint

  --------------------------------------------------------------------
  -- 2. Regime classification obligations
  --------------------------------------------------------------------

  -- Long-lived H1 features (persistence >= tau_long) correspond to
  -- stable cyclical regimes in canal health.[209][219]
  obligation LongLivedLoopRegime
    forall window_start, window_end, segment_id :
      tda_regime_shift_h1(window_start, window_end, segment_id) as H
    require not (H.persistence >= 0.10
                 and H.regime_flag <> "STABLE_LOOP")
  endobligation

  -- Short-lived H1 features (0 < persistence < tau_long) correspond to
  -- transient regime shifts or brief excursions.[209][219]
  obligation TransientLoopRegime
    forall window_start, window_end, segment_id :
      tda_regime_shift_h1(window_start, window_end, segment_id) as H
    require not (H.persistence > 0.0 and H.persistence < 0.10
                 and H.regime_flag <> "TRANSIENT_LOOP")
  endobligation

  --------------------------------------------------------------------
  -- 3. Coupling to KER/Lyapunov residual windows
  --------------------------------------------------------------------

  table tda_regime_shift_link
    column window_start    Utf8(8)   notnull
    column window_end      Utf8(8)   notnull
    column segment_id      Utf8(64)  notnull
    column residual_hex    Utf8(128) notnull   -- links into ker_residual_window
  endtable

  -- Regime shift detection obligation: long-lived loops at high V_t
  -- must trigger a governance review for the linked residual window.[4]
  obligation HighResidualStableLoopFlag
    forall window_start, window_end, segment_id :
      tda_regime_shift_h1(window_start, window_end, segment_id) as H,
      tda_regime_shift_link(window_start, window_end, segment_id) as L,
      ker_residual_window(L.residual_hex) as W
    require not (H.persistence >= 0.10
                 and W.vt_residual > 0.5
                 and H.regime_flag <> "STABLE_LOOP")
  endobligation

endschema
