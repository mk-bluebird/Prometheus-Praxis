# filename: ecorestorationshard/cyboquaticprogress/20260725/aln/BlastRadiusSurcharge20260725.aln
# destination: ecorestorationshard/cyboquaticprogress/20260725/aln/BlastRadiusSurcharge20260725.aln
# repo-target: https://github.com/mk-bluebird/Prometheus-Praxis

particle BlastRadiusSurcharge20260725v1
version 1
domain CYBOQUATIC
subdomain BLASTRADIUS_SURCHARGE
yyyymmdd 20260725

signingdid bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
evidencehex 0x20260725PHXBLASTRADIUS_SURCHARGE

lane RESEARCH

fields
    canal_node_id        TEXT
    fog_region_id        TEXT
    fog_channel_id       TEXT
    timestamputc         TEXT

    surcharge_index      REAL
    flow_m3s             REAL
    head_loss_m          REAL
    bulk_density_kg_m3   REAL
    energy_j             REAL

    blast_radius_m       REAL
    vt_residual          REAL
    r_energy             REAL
    r_hydraulics         REAL
    r_bio                REAL
    r_tox                REAL
    r_uncertainty        REAL
    r_topology           REAL

    k_knowledge          REAL
    e_ecoimpact          REAL
    r_risk               REAL
    kerscore             REAL

rules
    -- Bounds for normalized planes and K,E,R. [file:2]
    rule bounds_01:
        vt_residual      in [0.0, 1.0]
        r_energy         in [0.0, 1.0]
        r_hydraulics     in [0.0, 1.0]
        r_bio            in [0.0, 1.0]
        r_tox            in [0.0, 1.0]
        r_uncertainty    in [0.0, 1.0]
        r_topology       in [0.0, 1.0]
        k_knowledge      in [0.0, 1.0]
        e_ecoimpact      in [0.0, 1.0]
        r_risk           in [0.0, 1.0]
        kerscore         in [0.0, 1.0]

    rule blast_radius_nonnegative:
        blast_radius_m >= 0.0

    -- Simple K,E,R consistency; full kernel lives in Rust/SQL. [file:2][file:7]
    rule kerscore_def:
        approx kerscore == k_knowledge + e_ecoimpact - r_risk tolerance 0.05

    -- Governance: autoban if r_risk > 0.5 for N consecutive events (described in governance text). [file:2]
    rule governance_autoban:
        if r_risk > 0.5 then
            state.counter += 1
        else
            state.counter := 0

        if state.counter >= 5 then
            lane := "AUTOBANNED"

bindings
    sqlite_table blast_surcharge_radius
    evidence_column evidence_hex
    governance_particle BlastRadiusSurcharge20260725v1

comment
    "Non-actuating particle binding blast-radius surcharge diagnostics for 2026-07-25 to K,E,R triads and Phoenix evidence hex. Designed to integrate with dailyprogress, drainage-decay, workload energetics, and AI node energetics corridors under shared Lyapunov residual grammar." [file:2][file:11]
