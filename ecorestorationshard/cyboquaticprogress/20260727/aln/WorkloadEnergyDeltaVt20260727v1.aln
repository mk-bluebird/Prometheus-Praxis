END

RULES
  rule Bounds_r_energy
    require r_energy >= 0.0 && r_energy <= 1.0
  endrule

  rule Bounds_r_hydraulics
    require r_hydraulics >= 0.0 && r_hydraulics <= 1.0
  endrule

  rule Bounds_r_uncertainty
    require r_uncertainty >= 0.0 && r_uncertainty <= 1.0
  endrule

  rule Residual_nonnegative
    require vt_after >= 0.0 && vt_before >= 0.0
  endrule

  rule DeltaVt_contract
    # Always-improve obligation for workloads: ΔVt <= 0 for admissible frames.
    require delta_vt <= 0.0
  endrule

  rule KER_bounds
    require k_metric >= 0.0 && k_metric <= 1.0
    require e_metric >= 0.0 && e_metric <= 1.0
    require r_metric >= 0.0 && r_metric <= 1.0
  endrule

  rule Evidence_hex_binding
    require evidencehex == "0x20260727PHX3345NWorkloadEnergyDeltaVt"
    require signingdid == "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
  endrule
END

